          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "rgb-pane"
                    },
                    "reveal": "always",
                    "height": 32,
                    "position": "top"
                  },
                  "background": "background",
