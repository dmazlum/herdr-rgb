          "padding": [
            0,
            10
          ],
          "gap": 10,
          "background": {
            "gradient": [
              "#9d8bff00",
              "#9d8bff12"
            ],
            "angle": 160
          }
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "rgb-status"
          },
          "size": {
            "px": 36
          }
        }
